# Copy this file to backend/.env and fill in the values. backend/.env is never committed.

# --- Supabase: Project Settings -> API Keys ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SECRET key (sb_secret_...). Server only: never put it in the frontend or in git.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
# Only for OLD projects that sign logins with the legacy JWT secret (leave empty otherwise).
SUPABASE_JWT_SECRET=
STORAGE_BUCKET=images

# Frontend address(es) allowed to call this API, comma separated.
FRONTEND_ORIGINS=http://localhost:3000

# --- Image worker: mock | local | runpod ---
WORKER_MODE=mock
# black-forest-labs/FLUX.2-klein-4B (default, Apache-2.0)
# black-forest-labs/FLUX.2-klein-9B (non-commercial, gated)
# black-forest-labs/FLUX.1-schnell  (Apache-2.0, gated)
# black-forest-labs/FLUX.1-dev      (non-commercial, gated)
MODEL_ID=black-forest-labs/FLUX.2-klein-4B
# Leave empty to use each model's recommended steps/guidance.
DEFAULT_STEPS=
DEFAULT_GUIDANCE=
MOCK_DELAY_SECONDS=1.5

# Phase 2 (local) and Phase 3 (RunPod) settings, not used yet.
LOCAL_WORKER_URL=http://127.0.0.1:8001
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=
WORKER_TIMEOUT_SECONDS=300

# --- Cost protection ---
DAILY_LIMIT=10
MAX_CONCURRENT_JOBS=2
QUEUE_WAIT_SECONDS=60
RATE_LIMIT_PER_MINUTE=5
MAX_PROMPT_CHARS=1000
