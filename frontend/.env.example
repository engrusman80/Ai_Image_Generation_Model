# Copy this file to .env.local and fill in the values. These are PUBLIC values (safe in the browser).
# Never put the Supabase secret key, RunPod key or any other secret here.

# Supabase -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Where the FastAPI backend runs
NEXT_PUBLIC_API_URL=http://localhost:8000
