# Copy to worker/.env for local runs. Never commit worker/.env.

# Where model weights are stored (keep it OFF the C: drive).
HF_HOME=E:\Ai_Image_Generation_Model\.cache\huggingface
HF_HUB_DISABLE_TELEMETRY=1

# Must match MODEL_ID in backend/.env.
MODEL_ID=black-forest-labs/FLUX.2-klein-4B
# Leave empty to use the tested, pinned revision.
MODEL_REVISION=

# auto | gpu | offload | stream | nf4   (auto picks "stream" on an 8 GB GPU)
WORKER_MEMORY=auto
WORKER_PORT=8001

# Only for gated models (FLUX.1-schnell, FLUX.1-dev, FLUX.2-klein-9B): a Hugging Face read token.
HF_TOKEN=
